# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB=citypulse

# Gemini (Athena's Intelligence) — server-side only, never exposed to the client
GEMINI_API_KEY=

# Both Athena and Oracle use Gemini with distinct agent personas.

# Realtime
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
